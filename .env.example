# Database configuration (optional - defaults to embedded SQLite/PGlite if not set)
DATABASE_URL=

# AI Model Keys (optional - supports GEMINI_API_KEY, NVIDIA_API_KEY, or OPENAI_API_KEY)
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Telegram Bot integration (optional)
TELEGRAM_BOT_TOKEN=

# Agent Workspace Root path (defaults to /tmp/haley-workspace)
AGENT_WORKSPACE=
